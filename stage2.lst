   207                                  ; --------------- bios cursor functions --------------
   208                                  get_bios_cursor:
   209                                      ; need it because I dont want to clear screen in 32 protected mode
   210                                      ; it save cursors location as flat index
   211 000000E2 6631DB                      xor     ebx, ebx
   212 000000E5 B403                        mov     ah, 0x03        ; BIOS function 0x03: Read Cursor Position
   213 000000E7 B700                        mov     bh, 0           ; Page number 0
   214 000000E9 CD10                        int     0x10            ; Call BIOS video interrupt
   215                                      
   216                                      ; return: 
   217                                      ; DH = Row (0-24)
   218                                      ; DL = Column (0-79)
   219                                  
   220                                      ; Convert Row and Column into a single flat index: (Row * 80) + Column
   221 000000EB 660FB6C6                    movzx   eax, dh         ; EAX = Row
   222 000000EF 666BC050                    imul    eax, 80         ; EAX = Row * 80
   223 000000F3 660FB6DA                    movzx   ebx, dl         ; EBX = Column
   224 000000F7 6601D8                      add     eax, ebx        ; EAX = (Row * 80) + Column
   225                                  
   226 000000FA 66A3[E403]                  mov     [bios_cursor], eax 
   227 000000FE C3                          ret
