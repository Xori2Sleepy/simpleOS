   266 00000116 50                          push    ax
   267 00000117 53                          push    bx
   268 00000118 E8EBFF                      call    print_loop
   269                                      
   270                                      ; print first
   271 0000011B 88E0                        mov     al, ah
   272 0000011D C0E804                      shr     al, 4
   273 00000120 BB[D403]                    mov     bx, hex_map
   274 00000123 D7                          xlat
   275 00000124 E8D8FF                      call    print_char
   276                                      ; print second 
   277 00000127 88E0                        mov     al, ah
   278 00000129 240F                        and     al, 0Fh
   279 0000012B BB[D403]                    mov     bx, hex_map
   280 0000012E D7                          xlat
   281 0000012F E8CDFF                      call    print_char
   282                                      ; print line feed and NL
   283 00000132 B00D                        mov     al, 13
   284 00000134 E8C8FF                      call    print_char
   285 00000137 B00A                        mov     al, 10
   286 00000139 E8C3FF                      call    print_char
   287                                      
   288 0000013C 5B                          pop     bx
   289 0000013D 58                          pop     ax
   290 0000013E C3                          ret
