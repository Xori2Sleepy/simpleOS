   347                                  global  kernelcode_64bits_descriptor
   348                                  global  kerneldata_32bits_descriptor
   349                                  
   350                                  null_descriptor                     equ      0x00
   351                                  kernelcode_32bits_descriptor        equ      0x08
   352                                  kernelcode_64bits_descriptor        equ      0x10
   353                                  kerneldata_32bits_descriptor        equ      0x18
