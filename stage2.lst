     9                              <1> protected32_entry:
    10 0000040E FA                  <1>     cli
    11 0000040F 66B81800            <1>     mov     ax, kerneldata_32bits_descriptor
    12 00000413 8ED8                <1>     mov     ds, ax
    13 00000415 8ED0                <1>     mov     ss, ax
    14 00000417 8EC0                <1>     mov     es, ax
    15 00000419 8EE0                <1>     mov     fs, ax
    16 0000041B 8EE8                <1>     mov     gs, ax
    17                              <1> 
    18                              <1>     ; dint uses 7c00 cause old 16bits stack live there 
    19                              <1>     ; dint uses 9fbff because apprently EBDA can grow into those area...
    20 0000041D BC00500900          <1>     mov     esp, 0x95000
    21 00000422 E81A000000          <1>     call    deconstruct_bios_cursor
    22 00000427 E894000000          <1>     call    disable_cursor
    23 0000042C E89E000000          <1>     call    enable_cursor
    24                              <1>     
