    31                              <1> 
    32                              <1> 
    33                              <1> ; ---------- VGA functions ----------  
    34                              <1> ; 2000 slot of 80 col and 25 rows, each slot is 2 bytes
    35                              <1> ; 0xB8000 + (row * 80 + col) * 2 <= position logic
    36                              <1> 
    37                              <1> deconstruct_bios_cursor:
    38                              <1>     ; purpose: it get row and col information from when we are still in 16 bits real mode
    39                              <1>     ; input: NA
    40                              <1>     ; out: [current_row], [current_col]
    41                              <1>     ; clobbered: eax, edx, ecx, flags
    42                              <1>     ; note: we doesnt care what it clobbered, it call at the start anyway
    43 00000441 31FF                <1>     xor     edi, edi
    44 00000443 A1[E4030000]        <1>     mov     eax, [bios_cursor]
    45 00000448 E82C000000          <1>     call    position_translate  ; return row and col in al ah respectively
    46 0000044D A2[E4040000]        <1>     mov     [current_row], al
    47 00000452 8825[E8040000]      <1>     mov     [current_col], ah
    48 00000458 C3                  <1>     ret
    49                              <1> 
    50                              <1> clear_screen:
    51                              <1>     ; purpose: clear the screen
    52                              <1>     ; input: ah <- color
    53 00000459 8B3D[E0040000]      <1>     mov     edi, [VGA_buffer_base]
    54 0000045F B020                <1>     mov     al, 0x20            ; white space
    55 00000461 B9D0070000          <1>     mov     ecx, 2000           ; 2k cells
    56 00000466 FC                  <1>     cld
    57 00000467 66F3AB              <1>     rep     stosw
    58 0000046A C605[E4040000]00    <1>     mov     [current_row], 0
    59 00000471 C605[E8040000]00    <1>     mov     [current_col], 0
    60 00000478 C3                  <1>     ret                         ; es:edi
    61                              <1> 
    62                              <1> position_translate:
    63                              <1>     ; purpose: translate between linear and col/row address
    64                              <1>     ;        : max input for linear is 2000! and col/row is 25*80!
    65                              <1>     ; input: linear input -> edi = 0, eax = linear (strictly EAX!)
    66                              <1>     ;      : col/row input -> edi != 0, al = row, ah = col
    67                              <1>     ; output: linear input -> al =  row, ah = col
    68                              <1>     ;       : col/row input -> eax = linear address
    69 00000479 51                  <1>     push    ecx                 ; no point in saving eax and edi
    70 0000047A 85FF                <1>     test    edi, edi
    71 0000047C 740D                <1>     je      .linear_input
    72                              <1> 
    73                              <1> .col_row_input:
    74                              <1>     ; fall here
    75 0000047E 0FB6CC              <1>     movzx   ecx, ah
    76 00000481 0FB6C0              <1>     movzx   eax, al
    77 00000484 6BC050              <1>     imul    eax, 80
    78 00000487 01C8                <1>     add     eax, ecx            ; (al[row] * 80) + ah[col] in eax
    79 00000489 59                  <1>     pop     ecx
    80 0000048A C3                  <1>     ret
    81                              <1>     
    82                              <1> .linear_input:
    83                              <1>     ; div cl will divide al (16 bits)
    84 0000048B 66B95000            <1>     mov     cx, 80
    85 0000048F F6F1                <1>     div     cl                  ; div 8 bits is actually perfect for this job :D
    86                              <1>                                 ; al is row and ah is col now
    87 00000491 59                  <1>     pop     ecx
    88 00000492 C3                  <1>     ret
    89                              <1> 
    90                              <1> move_cursor:
    91                              <1>     ; purpose: well, its move cursor, what more there is to say...
    92                              <1>     ; input: al = row, ah = col
    93                              <1>     ; output: NA
    94                              <1>     ; clobbered: flags
    95 00000493 57                  <1>     push    edi
    96 00000494 51                  <1>     push    ecx
    97                              <1> 
    98 00000495 BF01000000          <1>     mov     edi, 1
    99 0000049A E8DAFFFFFF          <1>     call    position_translate  ; eax contain linear address
   100 0000049F 89C1                <1>     mov     ecx, eax
   101                              <1> 
   102                              <1>     ; work in 16 bits, VGA card cant understand 32 bits, alledgedly...
   103 000004A1 66BAD403            <1>     mov     dx, 0x3D4           ; VGA port
   104 000004A5 B00E                <1>     mov     al, 0x0E            ; register 14 select (high)
   105 000004A7 EE                  <1>     out     dx, al
   106                              <1> 
   107 000004A8 66BAD503            <1>     mov     dx, 0x3D5           ; writing data to VGA
   108 000004AC 88E8                <1>     mov     al, ch              ; write high byte first
   109 000004AE EE                  <1>     out     dx, al
   110                              <1> 
   111 000004AF 66BAD403            <1>     mov     dx, 0x3D4
   112 000004B3 B00F                <1>     mov     al, 0x0F            ; register 15 is low byte
   113 000004B5 EE                  <1>     out     dx, al
   114                              <1> 
   115 000004B6 66BAD503            <1>     mov     dx, 0x3D5
   116 000004BA 88C8                <1>     mov     al, cl
   117 000004BC EE                  <1>     out     dx, al
   118                              <1> 
   119 000004BD 59                  <1>     pop     ecx
   120 000004BE 5F                  <1>     pop     edi
   121 000004BF C3                  <1>     ret
   122                              <1>     
   123                              <1> disable_cursor:
   124 000004C0 66BAD403            <1>     mov     dx, 0x3D4           ; write to port 0x3D4
   125 000004C4 B00A                <1>     mov     al, 0x0A            ; write to 0A regs (cursor start)
   126 000004C6 EE                  <1>     out     dx, al
   127                              <1> 
   128 000004C7 66BAD503            <1>     mov     dx, 0x3D5           ; port 0x3D5, data send here
   129 000004CB B020                <1>     mov     al, 00100000b       ; bit 5 = 1, VGA stop render cursor
   130 000004CD EE                  <1>     out     dx, al
   131 000004CE C3                  <1>     ret
   132                              <1> enable_cursor:
   133 000004CF 66BAD403            <1>     mov     dx, 0x3D4
   134 000004D3 B00A                <1>     mov     al, 0x0A
   135 000004D5 EE                  <1>     out     dx, al
   136                              <1> 
   137 000004D6 66BAD503            <1>     mov     dx, 0x3D5
   138 000004DA B000                <1>     mov     al, 0x00            ; reset bit 5 to 0
   139 000004DC EE                  <1>     out     dx, al
   140 000004DD C3                  <1>     ret
