     1                                  [bits 16]
     2                                  [org 0x7E00]
     3                                  
     4                                  ; input: base, limit, access bytes, flags
     5                                  %macro gdt_entries 4
     6                                      dw      %2 & 0xFFFF         ; limit is 20 bits we only need first 16 here
     7                                      dw      %1 & 0xFFFF         ; base is 32 bits but we only need first 16 here
     8                                      db      (%1 >> 16) & 0xFF   ; we only need 16-23 bits
     9                                      db      %3                  ; acess bytes
    10                                      db      ((%4 << 4) | ((%2 >> 16) & 0x0F)) ; first 4 bits is the 'other' flags, rest is limit
    11                                      db      (%1 >> 24) & 0xFF   ; only need the last 8 bits
    12                                  %endmacro
    13                                  
    14                                  ; --------------- MAIN FUCNTION (basically) --------------- 
    15                                  stage2_entry:
    16                                      ; environmental setup, already did this in stage 1, but JUST TO MAKE SURE!
    17 00000000 FA                          cli
    18 00000001 31C0                        xor     ax, ax
    19 00000003 8ED8                        mov     ds, ax
    20 00000005 8EC0                        mov     es, ax
    21 00000007 8ED0                        mov     ss, ax
    22 00000009 BC007C                      mov     sp, 0x7c00
    23 0000000C FB                          sti
    24                                  
    25 0000000D B00D                        mov     al, 13
    26 0000000F E8ED00                      call    print_char          ; function doesnt clobbered anything, al resuable!
    27 00000012 B00A                        mov     al, 10
    28 00000014 E8E800                      call    print_char
    29 00000017 BE[3F01]                mov     si, msg
    30 0000001A E8E900                      call    print_loop
    31 0000001D E82000                      call    enable_a20
    32 00000020 E8BF00                      call    get_bios_cursor      ; need before jumping, make sure no write to buffer after this!
    33                                  
    34                                  
    35                                      ; coming for 32 mode. finally, I have escape the shackle of 16 bits programing!
    36 00000023 FA                          cli
    37 00000024 E470                        in      al, 0x70            ; Read current CMOS state
    38 00000026 0C80                        or      al, 0x80            ; Set bit 7 to mask NMIs
    39 00000028 E670                        out     0x70, al            ; Send to port 0x70 (cmos)
    40 0000002A E471                        in      al, 0x71            ; just a dummy read to clear bus, dangling 0x70 port is dangerous, or so I was told
    41                                  
    42 0000002C 0F0116[0804]                lgdt    [gdt_descriptor]    ; loading gdt to gdtr
    43 00000031 0F20C0                      mov     eax, cr0            ; I just discover that I can use 32 bits regs in real mode...
    44 00000034 6683C801                    or      eax, 1              ; turn the first bits of cr0 on (Protection Enable, PE bits)
    45 00000038 0F22C0                      mov     cr0, eax            ; protected mode officially on
    46                                  
    47 0000003B EA[0E04]0800                jmp     kernelcode_32bits_descriptor:protected32_entry
    48                                  
    49                                  ; ------------------------------------------------------------ 
    50                                  ;                A20 functions start here!
    51                                  ; ------------------------------------------------------------ 
    52                                  enable_a20:
    53                                      ; for some reason all the website out there make it look like this is some scary as hell process,
    54                                      ; i am kinda scare now ...
    55                                  
    56 00000040 E85200                      call    check_a20           ; alway check before anything
    57 00000043 7249                        jc      .a20_done
    58                                  
    59                                      ; 1: try to enable a20 using the bios interrupt method.
    60 00000045 B80124                      mov     ax, 2401h           ; function 2401h: Enable A20 GATE
    61 00000048 CD15                        int     15h                 ; call misc system service apparently
    62 0000004A E84800                      call    check_a20           ; doesnt clobbed ax (error code return from in t 15h)
    63 0000004D 723F                        jc      .a20_done
    64 0000004F BE[F602]                    mov     si, msg_bios_a20_failed
    65 00000052 E8C100                      call    print_error         ; args is error code in ah and string pointer in si
    66 00000055 BE[2503]                    mov     si, msg_bios_a20_cont
    67 00000058 E8AB00                      call    print_loop
    68                                  
    69                                      ; 2: a fallback method incase bios a20 activation fail
    70                                      ; utilize i/o ports on CPU and ask keyboard controler to enable A20
    71 0000005B FA                          cli
    72                                  .wait_keyboard_ctrl_resp:
    73 0000005C E464                        in      al, 64h             ; read the regs of keyboard controler, 8 bits,
    74                                                                  ; store info from ports 64h to al
    75 0000005E A802                        test    al, 2               ; and 0000 0010 to isolate second bits (bits 1 AKA status bit) for testing status
    76 00000060 75FA                        jnz     .wait_keyboard_ctrl_resp    ; if we AND and it give zero it meant status bit is off and empty-
    77                                                                  ; -which mean we can safely use mov to talk to keyboard controler
    78 00000062 B0DF                        mov     al, 0xDF            ; 0xDF the command for enabling A20, DD is disabling!
    79 00000064 E664                        out     64h, al             ; send info on al to cpu I/O port 64h 
    80 00000066 FB                          sti
    81 00000067 E82B00                      call    check_a20
    82 0000006A 7222                        jc      .a20_done
    83 0000006C BE[5803]                    mov     si, msg_kb_ctrl_failed
    84 0000006F E89400                      call    print_loop
    85                                  
    86                                      ; 3: fast port 92h, a modern and fast alternative to port 64h (keyboard controller)
    87                                      ; we also need to make sure bits 0 is off incase accidental hard reset
    88 00000072 E492                        in      al, 92h             ; also respond to several other system level switch!
    89 00000074 0C02                        or      al, 2               ; set bits 1 to 1 (this the A20 bit!)
    90 00000076 24FE                        and     al, 0xFE            ; set bits 0 to 0 to prevent accidental hard reset
    91 00000078 E692                        out     92h, al             ; write update to port
    92 0000007A E81800                      call    check_a20
    93 0000007D 720F                        jc      .a20_done
    94 0000007F BE[A603]                    mov     si, msg_ff_failed
    95 00000082 E88100                      call    print_loop
    96                                  
    97                                      ; some other method but too obscue might break thing :( dont want to remove it though so it stay as comment
    98                                      ; 4: desperate time require desperate measure, fast and dirty 0EEh! (for 386SL / Geode)
    99                                      ;in      al, 0EEh            ; Some chipsets enable A20 just by reading this port apparently???
   100                                  
   101                                      ; 5: search the depth of internet for Phoenix/C&T stuff idk
   102                                      ;in      al, 61h
   103                                      ;or      al, 0x80            ; force latch high
   104                                      ;and     al, 0xFE            ; clear bit 0 so speaker doesnt scream cause this thing also control other stuff
   105                                      ;out     61h, al
   106                                      ;call    check_a20
   107                                  
   108                                  .a20_failed:
   109                                      ; code will fall here naturally if a20 fail
   110 00000085 BE[CC01]                    mov     si, msg_a20_failed
   111 00000088 E87B00                      call    print_loop
   112 0000008B E84A00                      call    halt                ; if it truly fail there is not point to let the code run wild,
   113                                                                  ; halting is the best and most responsible option
   114                                  
   115                                  .a20_done:
   116 0000008E BE[8901]                    mov     si, msg_a20_success
   117 00000091 E87200                      call    print_loop
   118 00000094 C3                          ret
