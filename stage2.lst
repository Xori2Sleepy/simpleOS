   121                                  ; ------------------------------------------------------------ 
   122                                      
   123                                  ; ---------- functions ---------- 
   124                                  ; ig you can say this is a helper function section
   125                                  ; ------------------------------------------------------------ 
   126                                  ;               Check A20 functions start here
   127                                  ; ------------------------------------------------------------ 
   128                                  check_a20:
   129                                      ; input: NA
   130                                      ; output: carry flag, set mean a20 is on vise versa
   131                                      ; clobbled: carry flag (potentially memory corruption but highly unlikely), 
   132                                  
   133                                      ; principle is that higest possible address is 0xFFFF:0xFFFF which is 0xFFFF * 16 + 0xFFFF
   134                                      ; = 0x10FFF0, the cpu cant see that 10 in __FFEF so it it wrap to FFEF. We just have to write to some address
   135                                      ; (in this case i choose 0x500 cause it stack bottom, unless you got crazy stack aint no data gonna be here -
   136                                      ; - so it fine even if it corrupt)
   137                                      ; then we write another stuff to 10500, if it unwrap our value should still be there, if it is wrap it will be overwrite
   138                                      ; with new value, we just have to compare the 0x500 with our new value, if equal than a20 not on
   139 00000095 9C                          pushf
   140 00000096 50                          push    ax
   141 00000097 56                          push    si
   142 00000098 57                          push    di
   143 00000099 1E                          push    ds
   144 0000009A 06                          push    es
   145 0000009B FA                          cli
   146                                  
   147 0000009C 31C0                        xor     ax, ax
   148 0000009E 8ED8                        mov     ds, ax              ; data segment = 0x0000
   149 000000A0 BE0005                      mov     si, 0x500           ; 0x0000:0x0500, we know 0x500 is safe memory zone
   150                                  
   151 000000A3 F7D0                        not     ax                  ; 0xFFFF in ax
   152 000000A5 8EC0                        mov     es, ax              ; extra segment = 0xFFFF
   153 000000A7 BF1005                      mov     di, 0x0510
   154                                  
   155                                      ; we saved stuff, dont want memory corruption after all
   156 000000AA 3E8A04                      mov     al, [ds:si]         ; this represent the non wrap address
   157 000000AD 50                          push    ax
   158 000000AE 268A05                      mov     al, [es:di]         ; this represent the "beyond" address
   159 000000B1 50                          push    ax
   160                                  
   161 000000B2 3EC60467                    mov     byte [ds:si], 0x67  ; random value to non wrap address
   162 000000B6 26C605FF                    mov     byte [es:di], 0xFF  ; if it wrap this should overwrite 0x67
   163                                  
   164 000000BA 3E803CFF                    cmp     byte [ds:si], 0xFF  ; the non wrap address equal the beyond address, it wrap
   165                                  
   166 000000BE 58                          pop     ax
   167 000000BF 268805                      mov     [es:di], al
   168 000000C2 58                          pop     ax
   169 000000C3 3E8804                      mov     [ds:si], al
   170                                  
   171 000000C6 7408                        je      .a20_disabled
   172                                  
   173                                  .a20_enabled:
   174                                      ; naturally fall here
   175 000000C8 07                          pop     es
   176 000000C9 1F                          pop     ds
   177 000000CA 5F                          pop     di
   178 000000CB 5E                          pop     si
   179 000000CC 58                          pop     ax
   180 000000CD 9D                          popf
   181 000000CE F9                          stc
   182 000000CF C3                          ret
   183                                  
   184                                  .a20_disabled:
   185 000000D0 07                          pop     es
   186 000000D1 1F                          pop     ds
   187 000000D2 5F                          pop     di
   188 000000D3 5E                          pop     si 
   189 000000D4 58                          pop     ax
   190 000000D5 9D                          popf
   191 000000D6 F8                          clc
   192 000000D7 C3                          ret
   193                                  ; ------------------------------------------------------------ 
   194                                  ;               Check A20 functions end here
   195                                  ; ------------------------------------------------------------ 
