   197                                  ; --------------- small halt functions ---------------
   198                                  halt:
   199                                      ; halt the cpu
   200 000000D8 BE[C902]                    mov     si, msg_cpu_halted
   201 000000DB E82800                      call    print_loop
   202                                  .halt_loop:
   203 000000DE FA                          cli
   204 000000DF F4                          hlt
   205 000000E0 EBFC                        jmp     .halt_loop
