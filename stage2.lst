   309                                  ; -------------------- gdt space ------------------------
   310                                  gdt_start:
   311                                      ; lower limit -> 2 byte (16 bits - 0 - 15)
   312                                      ; lower base -> 3 byte (24 bits - 0 - 23)
   313                                  
   314                                      ; flags:
   315                                      ; 7 -> present?
   316                                      ; 6-5 -> ring level
   317                                      ; 4 -> code/data segment or speicial system structure
   318                                      ; 3 -> code seg
   319                                      ; 2 -> conforming/direction
   320                                      ; 1 -> rw for code 1 allow reading and for data 1 allow writing
   321                                      ; 0 -> cpu access, set to zero, legacy feature not important if use paging
   322                                      ; bit 3,2,1,0 become type field if it a system structure
   323                                      
   324                                      ; other flags:
   325                                      ; 7 -> granularity = multiply memory by 4 kb and scale 20 bits limit to 32 bits (4gb)
   326                                      ; 6 -> D/B size/bigflags. if code then this control if it uses 32 bit protected or not, if data then stack pointer size
   327                                      ; 5 -> long/64 bits flag. 64 bits code?
   328                                      ; AVL -> avaliable flag, not used by CPU, for kernel
   329                                      ; 3-0 -> bit 16-19 of limit (MSB)
   330                                  
   331                                      ; base bit -> extra byte for base (24-31) giving total of 32 bits
   332                                  
   333                                      ; (32 bits) base, (20 bits) limit, (bytes) access bytes, (4 bits) others flags
   334                                      gdt_entries 0, 0, 0, 0                      ; 0x00 - null descriptor
     6 000003E8 0000                <1>  dw %2 & 0xFFFF
     7 000003EA 0000                <1>  dw %1 & 0xFFFF
     8 000003EC 00                  <1>  db (%1 >> 16) & 0xFF
     9 000003ED 00                  <1>  db %3
    10 000003EE 00                  <1>  db ((%4 << 4) | ((%2 >> 16) & 0x0F))
    11 000003EF 00                  <1>  db (%1 >> 24) & 0xFF
   335                                      gdt_entries 0, 0xFFFFF, 10011010b, 1100b    ; 0x08 - 32 bits Kernel code segment descriptor
     6 000003F0 FFFF                <1>  dw %2 & 0xFFFF
     7 000003F2 0000                <1>  dw %1 & 0xFFFF
     8 000003F4 00                  <1>  db (%1 >> 16) & 0xFF
     9 000003F5 9A                  <1>  db %3
    10 000003F6 CF                  <1>  db ((%4 << 4) | ((%2 >> 16) & 0x0F))
    11 000003F7 00                  <1>  db (%1 >> 24) & 0xFF
   336                                      gdt_entries 0, 0xFFFFF, 10011010b, 0010b    ; 0x10 - 64 bits Kernel code segment descriptor
     6 000003F8 FFFF                <1>  dw %2 & 0xFFFF
     7 000003FA 0000                <1>  dw %1 & 0xFFFF
     8 000003FC 00                  <1>  db (%1 >> 16) & 0xFF
     9 000003FD 9A                  <1>  db %3
    10 000003FE 2F                  <1>  db ((%4 << 4) | ((%2 >> 16) & 0x0F))
    11 000003FF 00                  <1>  db (%1 >> 24) & 0xFF
   337                                      gdt_entries 0, 0xFFFFF, 10010010b, 1100b    ; 0x18 - 32 bits Data segment descriptor
     6 00000400 FFFF                <1>  dw %2 & 0xFFFF
     7 00000402 0000                <1>  dw %1 & 0xFFFF
     8 00000404 00                  <1>  db (%1 >> 16) & 0xFF
     9 00000405 92                  <1>  db %3
    10 00000406 CF                  <1>  db ((%4 << 4) | ((%2 >> 16) & 0x0F))
    11 00000407 00                  <1>  db (%1 >> 24) & 0xFF
   338                                  gdt_end:
   339                                  
   340                                  gdt_descriptor:
   341                                      ; for lgdt, 6 byte, first 2 must be size and last 4 must be gdt address
   342 00000408 1F00                        dw      gdt_end - gdt_start - 1         ; gdt size - 1
   343 0000040A [E8030000]                  dd      gdt_start
